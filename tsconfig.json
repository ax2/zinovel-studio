{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "esModuleInterop": true,
    "skipLibCheck": true, "allowJs": true, "checkJs": false,
    "lib": ["ES2022", "DOM"], "types": ["node"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts"]
}
