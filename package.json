{
  "name": "zinovel-studio",
  "version": "0.1.0-alpha.40",
  "private": true,
  "description": "Local-first novel writing desktop based on official DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm check:planning",
    "build": "node scripts/build.mjs",
    "check:planning": "node scripts/check-project.mjs",
    "typecheck": "tsc --noEmit",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:agent": "node scripts/smoke-harness.mjs && node scripts/smoke-novel-agent.mjs",
    "test:library": "node scripts/smoke-library.mjs",
    "test:editor-tools": "node scripts/smoke-editor-tools.mjs",
    "test:recovery": "node scripts/smoke-recovery.mjs",
    "test:merge": "node scripts/smoke-merge.mjs",
    "test:shelf": "node scripts/smoke-shelf.mjs",
    "test:writing-views": "node scripts/smoke-writing-views.mjs",
    "test:tasks": "node scripts/smoke-tasks.mjs",
    "test:acceptance": "node scripts/smoke-acceptance.mjs",
    "test:task-compatibility": "node scripts/smoke-task-compatibility.mjs",
    "test:stream": "node scripts/smoke-stream.mjs",
    "test:budget": "node scripts/smoke-budget.mjs && node scripts/smoke-budget-ui.mjs",
    "test:candidate-review": "node scripts/smoke-candidate-review.mjs",
    "test:materials": "node scripts/smoke-materials.mjs",
    "test:evidence": "node scripts/smoke-evidence.mjs",
    "test:material-context": "node scripts/smoke-material-context.mjs",
    "test:material-proposal": "node scripts/smoke-material-proposal.mjs",
    "test:planning-ui": "node scripts/smoke-planning.mjs",
    "test:scene-tree": "node scripts/smoke-scene-tree.mjs && node scripts/smoke-scene-tree-operations.mjs",
    "test:world-proposals": "node scripts/smoke-world-proposals.mjs",
    "test:pilots": "node scripts/smoke-pilots.mjs",
    "test:pilot-agent": "node scripts/smoke-pilot-agent.mjs",
    "test:continuity": "node scripts/smoke-continuity.mjs",
    "test:relationships": "node scripts/smoke-relationships.mjs",
    "test:knowledge": "node scripts/smoke-knowledge.mjs",
    "test:knowledge-choices": "node scripts/smoke-knowledge-choices.mjs",
    "test:knowledge-legacy": "node scripts/smoke-knowledge-legacy.mjs",
    "test:knowledge-creation": "node scripts/smoke-knowledge-creation.mjs",
    "test:knowledge-context": "node scripts/smoke-knowledge-context.mjs && node scripts/smoke-knowledge-context-targets.mjs",
    "test:creative-journey": "node scripts/smoke-creative-journey.mjs",
    "test:reader": "node scripts/smoke-reader.mjs && node scripts/smoke-reader-cleanup.mjs",
    "benchmark:continuity": "node scripts/benchmark-continuity.mjs",
    "benchmark:knowledge": "node scripts/benchmark-knowledge.mjs",
    "test:benchmark": "node scripts/benchmark-writing.mjs",
    "package:dir": "pnpm build && electron-builder --config electron-builder.config.cjs --win --x64 --dir --publish never && node scripts/verify-package-launch.mjs",
    "package:win": "pnpm package:dir && node scripts/smoke-packaged.mjs && electron-builder --config electron-builder.config.cjs --prepackaged release/win-unpacked --win --x64 --publish never",
    "test:installer": "node scripts/smoke-installer.mjs",
    "test:upgrade": "node scripts/smoke-upgrade.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:verify-public": "node scripts/verify-public-release.mjs",
    "test:publication-foundation": "node scripts/smoke-publication-foundation.mjs",
    "test:publication-capture": "node scripts/smoke-publication-capture.mjs",
    "test:pdf-layout": "node scripts/smoke-publication-pdf-layout.mjs",
    "test:docx-layout": "node scripts/smoke-publication-docx-layout.mjs",
    "test:publication-resources": "node scripts/smoke-publication-resources.mjs",
    "test:publication-ui": "node scripts/smoke-publication-ui.mjs && node scripts/smoke-publication-html-output.mjs && node scripts/smoke-publication-pdf-output.mjs && node scripts/smoke-publication-docx-output.mjs",
    "test:assets": "node scripts/smoke-assets.mjs",
    "test:image-studio": "node scripts/smoke-image-studio.mjs",
    "test:reference-images": "node scripts/smoke-reference-images.mjs",
    "test:maps-ipc": "node scripts/smoke-maps-ipc.mjs",
    "test:maps-ui": "node scripts/smoke-maps-ui.mjs",
    "test:atlas-ui": "node scripts/smoke-map-atlas-ui.mjs",
    "test:utf8-integrity": "node scripts/smoke-utf8-integrity.mjs",
    "test:offline-writing": "node scripts/smoke-offline-writing.mjs",
    "test:backup-boundary": "node scripts/smoke-independent-backup.mjs --allow-same-disk",
    "test:tool-isolation": "node scripts/smoke-tool-isolation.mjs",
    "test:backup-vault": "node scripts/smoke-backup-vault.mjs --allow-same-disk",
    "test:diagnostics": "node scripts/smoke-diagnostics.mjs",
    "test:model-credentials": "node scripts/smoke-model-credentials.mjs",
    "test:model-profiles": "node scripts/smoke-model-profiles.mjs",
    "test:character-looks": "node scripts/smoke-character-looks.mjs",
    "test:import-boundary": "node scripts/smoke-import-boundary.mjs",
    "test:import-review": "node scripts/smoke-import-review.mjs",
    "test:import-origin": "node scripts/smoke-import-origin.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ax2/zinovel-studio.git"
  },
  "main": "dist/desktop/main.cjs",
  "packageManager": "pnpm@10.3.0",
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.2",
    "koffi": "3.1.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@deepseek-ai/libreoffice-kit": "0.1.5",
    "@types/node": "22.20.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "docx": "9.14.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.25.12",
    "lucide-react": "0.468.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "koffi",
      "node-pty"
    ],
    "patchedDependencies": {
      "app-builder-lib@26.17.0": "patches/app-builder-lib@26.17.0.patch"
    }
  }
}
